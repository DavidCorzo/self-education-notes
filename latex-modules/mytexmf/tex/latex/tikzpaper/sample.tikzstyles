% TiKZ style file generated by TikZiT. You may edit this file manually,
% but some things (e.g. comments) may be overwritten. To be readable in
% TikZiT, the only non-comment lines must be of the form:
% \tikzstyle{NAME}=[PROPERTY LIST]

% Node styles
\tikzstyle{red dot}=[fill=red, draw=black, shape=circle]
\tikzstyle{green dot}=[fill={rgb,255: red,0; green,200; blue,80}, draw=black, shape=circle]
\tikzstyle{white dot}=[fill=white, draw=black, shape=circle]
\tikzstyle{white}=[fill=white, draw=black, shape=rectangle]
\tikzstyle{darkdot}=[circle, fill, minimum size=5pt, inner sep=0pt, outer sep=0pt]

% Edge styles
\tikzstyle{line with arrow}=[->]
\tikzstyle{dashed line}=[-, dashed]
\tikzstyle{attention}=[-]
\tikzstyle{arrowws}=[postaction={{{decorate,decoration={markings,mark=between positions 3pt and 1 step 10pt with {\arrow{>};}}}}}, dash pattern=on 3pt off 2pt, -]
\tikzstyle{line}=[->, dashed]
\tikzstyle{double arrow}=[<->]
