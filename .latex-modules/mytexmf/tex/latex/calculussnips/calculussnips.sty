\newcommand{\intbyparts}[6]{ 
    % 1->function 2->var 3->u, 4->du, 5->dv, 6->v
    \begin{center}
        \[
        \int #1 d#2
        \]
        \begin{align*}
            u &= #3 \quad \qquad dv = #5 d#2 \\ 
            du &= #4 d#2 \quad \qquad v = #6 \\ 
        \end{align*} 
        \[
            \underbrace{\left(#3\right)}_{u}
            \underbrace{\left(#6\right)}_{v}
            -\int
            \underbrace{\left(#6\right)}_{v}
            \underbrace{\left(#4\right)}_{du} 
    \]  
    \end{center}
} % abreviation: 


